# Any vision-capable model LiteLLM supports, as "provider/model".
# Examples: gemini/gemini-2.5-flash  openai/gpt-4.1-mini  anthropic/claude-sonnet-5-5  ollama_chat/qwen2.5vl
MODEL=gemini/gemini-2.5-flash

# Set the key for the provider you picked (LiteLLM reads these names).
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# Where sets and photos are stored. Keep these on a persistent disk.
DB_PATH=data/tango.db
IMAGES_DIR=data/images

# "Find cards": any OpenAI-compatible chat server. Default: a local vLLM on :9200.
# Leave these out and everything else still works; the finder just says it's off.
# HELPER_API_BASE=http://127.0.0.1:9200/v1
# HELPER_MODEL=qwen3.8-27b
# HELPER_API_KEY=
